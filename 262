path="$1"

case "$(uname -s)" in
  Darwin) default_jobs=60 ;;
  *)      default_jobs=0 ;;
esac

JOBS="${JOBS:-$default_jobs}"

find "$path" -name '*.js' | grep -v "FIXTURE" | sort | xargs -n 1 -P "$JOBS" -I {} sh -c '
tmp="$(mktemp)"
{
  echo "$1:"
  ./target/release/test262 "$1"
} > "$tmp" 2>&1
cat "$tmp"
rm -f "$tmp"
' sh {}
